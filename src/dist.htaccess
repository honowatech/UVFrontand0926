# =============================================================================
# unevoyante.fr — configuration Apache / LiteSpeed de la version publiée
# Source : src/dist.htaccess, copiée en dist/.htaccess par `npm run statique`.
# Ne pas modifier dist/.htaccess directement : il serait écrasé au build.
# =============================================================================

Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hébergement servant la racine du dépôt (voir le .htaccess racine) : une
  # adresse /dist/… visitée directement est ramenée à son adresse publique.
  RewriteCond %{THE_REQUEST} \s/dist/(\S*)\s
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# Compression des formats texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml text/plain
</IfModule>

# Cache. Les noms de fichiers ne portent pas d'empreinte : HTML, CSS, JS et
# polices sont revalidés à chaque visite (réponse 304 légère s'ils n'ont pas
# changé), sans quoi une mise en ligne mettrait des jours à atteindre les
# visiteurs — une police d'icônes périmée afficherait des noms d'icônes.
# Seules les images, stables, restent en cache 30 jours.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|woff2|json|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
